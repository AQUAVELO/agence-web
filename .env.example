# Configuration Aquavelo
# Copiez ce fichier en .env et remplissez les valeurs

# OpenAI API (Calculateur Minceur)
OPENAI_API_KEY=sk-proj-VOTRE_CLE_ICI

# Google Calendar API (Service Account JSON en base64)
# Pour générer : base64 -i google_key.json | tr -d '\n'
GOOGLE_CALENDAR_KEY_JSON_BASE64=

# Ou bien, spécifiez directement les champs individuels :
GOOGLE_PROJECT_ID=aquavelo-calendar
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=

# Base de données (si nécessaire pour override)
# DB_HOST=
# DB_NAME=
# DB_USER=
# DB_PASS=

# Mailjet
# MAILJET_USERNAME=
# MAILJET_PASSWORD=

# SMS Factor
# SMSFACTOR=

# WhatsApp Cloud API (Meta) — envoi 1h après le RDV
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=merci_seance_essai
# WHATSAPP_TEMPLATE_LANG=fr

# Redis
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=

# Resamania API — SANDBOX (ne jamais y mettre les secrets de production)
# RESAMANIA_ENV=sandbox
# RESAMANIA_BASE_URL=https://gateway.prod.gravitee.stadline.tech/resa2-staging
# RESAMANIA_GRANT_TYPE=http://clubclientcredentials
# RESAMANIA_CLIENT_ID=
# RESAMANIA_CLIENT_SECRET=
# RESAMANIA_API_KEY=
# RESAMANIA_CLIENT_TOKEN=demoapi
# RESAMANIA_CLUB_ID=/demoapi/clubs/1454
# RESAMANIA_NETWORK_NODE_ID=/demoapi/network_nodes/1600
# RESAMANIA_CLUB_CANNES_ID=/demoapi/clubs/1454
# RESAMANIA_NETWORK_CANNES_ID=/demoapi/network_nodes/1600
# RESAMANIA_CLUB_ANTIBES_ID=/demoapi/clubs/1453
# RESAMANIA_NETWORK_ANTIBES_ID=/demoapi/network_nodes/1599
