# Configuration Aquavelo
# Copiez ce fichier en .env et remplissez les valeurs

# Google Calendar API (Service Account JSON en base64)
# Pour générer : base64 -i google_key.json | tr -d '\n'
GOOGLE_CALENDAR_KEY_JSON_BASE64=

# Ou bien, spécifiez directement les champs individuels :
GOOGLE_PROJECT_ID=aquavelo-calendar
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=

# Base de données (si nécessaire pour override)
# DB_HOST=
# DB_NAME=
# DB_USER=
# DB_PASS=

# Mailjet
# MAILJET_USERNAME=
# MAILJET_PASSWORD=

# SMS Factor
# SMSFACTOR=

# Redis
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=
