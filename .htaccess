<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On
    RewriteBase /

    # 1. EXCLUSIONS : Ne pas réécrire le dossier du FS Bucket et les assets
    # Cette règle permet d'accéder directement aux fichiers stockés dans /cloud
    RewriteRule ^(css|js|images|fonts|uploads|cloud|vendor)/ - [L]
    RewriteRule \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot|pdf|zip|xml|txt)$ - [L]
    
    # Fichiers PHP utilitaires (accès direct autorisé)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(check_paris12|test_connexion|fix_db_direct|api_handler|cron_sync_google|test_menu_images)\.php$ - [L]

    # 2. REDIRECTIONS 301 - Nettoyage erreurs 404
    
    # Anciennes URLs de centres obsolètes → Liste centres
    RewriteRule ^centres/(Boulogne-Billancourt|Sainte-Genevieve-des-Bois|Menton)/?$ /centres [R=301,L]
    
    # Correction directe des typos et formats sans accents → URL correcte avec accents
    RewriteRule ^centres/(frejus|Frejus)/?$ /centres/Fréjus [R=301,NC,L]
    RewriteRule ^centres/(hyeres|Hyeres)/?$ /centres/Hyères [R=301,NC,L]
    RewriteRule ^centres/(saint-raphael|Saint-Raphael)/?$ /centres/Saint-Raphaël [R=301,NC,L]
    
    # Séances découverte obsolètes → Formulaire général
    RewriteRule ^seance-decouverte/(.*)$ /?p=free [R=301,L]
    
    # Blog et articles obsolètes → Accueil
    RewriteRule ^(blog|Blog\.php|articles\.php|Post\.php).*$ / [R=301,L]
    
    # Pages admin et connexion → Accueil (404 évité)
    RewriteRule ^(Admin\.php|Login-Aquavelo-Blog\.php|Dashboard\.php|editpost\.php|NewPost\.php).*$ / [R=301,L]
    
    # Anciennes pages de paiement
    RewriteRule ^(annulation|vente_ko|error)\.php$ / [R=301,L]
    
    # Anciennes pages tests et obsolètes
    RewriteRule ^(test_.*|traitement_.*|envoi.*|analyse.*|affichage.*|menu.*|index_.*|crop|reset_password|new_password)\.php$ / [R=301,L]
    
    # Pages de suivi et mensurations obsolètes → Contact (saisieMensurations et suiviReguliers exclus car actifs)
    RewriteRule ^(connexion_mensurations|indexMesure)\.php$ /contact [R=301,L]
    
    # Concept aquabiking
    RewriteRule ^concept-aquabiking/?$ /?p=aquabiking [R=301,L]

    # 3. REDIRECTIONS SEO : Anciennes pages .php vers URLs propres
    RewriteRule ^(vente_formule|vente_cryo|vente_prix|vente_prixprod|vente_cryoprod)\.php$ $1 [R=301,L]

    # 3. ROUTES VERS index.php (Aquavelo spécifique)
    
    # Processus de vente et Inscription
    RewriteRule ^vente_formule/?$ index.php?p=vente_formule [QSA,L]
    RewriteRule ^vente_cryo/?$ index.php?p=vente_cryo [QSA,L]
    RewriteRule ^vente_prix/?$ index.php?p=vente_prix [QSA,L]
    RewriteRule ^vente_prixprod/?$ index.php?p=vente_prixprod [QSA,L]
    RewriteRule ^vente_cryoprod/?$ index.php?p=vente_cryoprod [QSA,L]
    RewriteRule ^inscription/?$ index.php?p=vente_formule [QSA,L]
    
    # Gestion des centres et villes
    RewriteRule ^centres/([^/]+)/?$ index.php?p=page&city=$1 [QSA,L]
    RewriteRule ^centres/?$ index.php?p=centers [QSA,L]

    # Pages de contenu et divers
    RewriteRule ^(aquabiking|aquagym|contact|free|franchise|conseilminceur|cryolipolyse)/?$ index.php?p=$1 [QSA,L]

</IfModule>

# Gestion de l'erreur 404
ErrorDocument 404 /index.php
